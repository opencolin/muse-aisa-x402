# Copy to .env. Never commit .env.
# Arc mainnet only. The demo pays eip155:5042.

# One of these. The address this derives is the wallet that must hold Arc USDC.
DEMO_MNEMONIC=
PRIVATE_KEY=

# Optional. Not used by the x402 buy. key-check uses it against the v1 API.
AISA_API_KEY=

# Optional override.
ARC_RPC=https://rpc.mainnet.arc.io
